<Project Sdk="Microsoft.NET.Sdk">
  <!-- Проверки «Лоцмана Lite»: разбор ссылок, конфиги ядра, бережные пачки, резервная копия. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Locman7.Tests</AssemblyName>
    <RootNamespace>Locman7</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\src\Nodes.cs;..\src\XrayConfig.cs;..\src\Core.cs;..\src\Features.cs;..\src\Engine.cs" />
    <Compile Include="Tests.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\catalog\catalog.json" LogicalName="catalog.json" />
  </ItemGroup>
</Project>
